{
  "name": "adressevaelger",
  "version": "5.0.1",
  "description": "A UI component for implementing Adressevælger search in Javascript applications.",
  "author": {
    "name": "Klimadatastyrelsen",
    "email": "support@kds.dk",
    "url": "https://www.klimadatastyrelsen.dk"
  },
  "homepage": "https://www.klimadatastyrelsen.dk",
  "bugs": {
    "url": "https://www.klimadatastyrelsen.dk/om-klimadatastyrelsen/kontakt"
  },
  "license": "MIT",
  "main": "./dist/adressevaelger.cjs",
  "module": "./dist/adressevaelger.esm.js",
  "exports": {
    ".": {
      "import": "./dist/adressevaelger.esm.js",
      "require": "./dist/adressevaelger.cjs",
      "default": "./dist/adressevaelger.esm.js"
    },
    "./adressevaelger.css": "./dist/adressevaelger.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/index.html"
  ],
  "type": "module",
  "scripts": {
    "build": "node bin/build.js",
    "prepack": "node bin/build.js",
    "dev": "node bin/dev.js",
    "test": "playwright test",
    "test:live": "ADRESSEVAELGER_LIVE_API=1 playwright test",
    "capture-fixtures": "node bin/capture-fixtures.js"
  },
  "keywords": [
    "Adressevælger",
    "adressevaelger"
  ],
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
