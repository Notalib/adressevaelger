{
  // Compiles check.ts the way a consumer would see the package, so the
  // generated declarations cannot quietly stop matching what is exported.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "paths": {
      "@notalib/adressevaelger": ["../dist/types/index.d.ts"]
    }
  },
  "include": ["check.ts"]
}
